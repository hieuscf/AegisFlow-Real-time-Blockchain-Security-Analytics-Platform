# Server
PORT=8080

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=analytics-core-group
KAFKA_TOPIC=market-swaps
KAFKA_SECURITY_ALERTS_TOPIC=security-alerts

# Redis
REDIS_URL=redis://localhost:6379

# PostgreSQL (match infra/docker/.env)
DATABASE_URL=postgresql://aegis_admin:aegis_password_2026@localhost:5432/aegisflow_db

# Auth (SIWE + JWT)
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRES_IN=24h
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:8080
SIWE_NONCE_TTL_SECONDS=300

# Anomaly detection (0.5 = 50% drop vs moving average)
ANOMALY_DROP_THRESHOLD=0.5
ALERT_DEDUPE_TTL_SECONDS=60

# Slither (set SLITHER_ENABLED=true when CLI is installed)
SLITHER_ENABLED=false
SLITHER_COMMAND=slither
MAX_CONCURRENT_AUDITS=2
SLITHER_TIMEOUT_MS=120000
