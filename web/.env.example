# Analytics API + Socket.IO (browser must reach this URL)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=http://localhost:8080

# WalletConnect Cloud project id (https://cloud.walletconnect.com)
# Required for mobile / QR wallets. MetaMask browser extension works without this.
VITE_WALLETCONNECT_PROJECT_ID=your_walletconnect_cloud_project_id
