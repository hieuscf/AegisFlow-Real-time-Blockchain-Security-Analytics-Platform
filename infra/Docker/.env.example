# =============================================================================
# AegisFlow — Infrastructure environment variables (TEMPLATE)
# =============================================================================
# Copy to .env and replace placeholder values before running:
#   copy .env.example .env
#   docker compose up -d
#
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL (credentials — HIGH sensitivity) ---------------------------
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aegisflow_db
POSTGRES_PORT=5432

# Connection URL for application services (Indexer, Analytics Core)
DATABASE_URL=postgresql://aegis_admin:change_me_strong_password@localhost:5432/aegisflow_db

# --- Redis (cache — MEDIUM sensitivity if password enabled) ----------------
REDIS_PORT=6379
# Leave empty for local dev without auth; set a strong password in production
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Kafka (event bus — MEDIUM sensitivity in production) ------------------
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_BOOTSTRAP=kafka:29092
KAFKA_BROKER_PORT=9092

# MVP topic names (created by kafka-init on startup)
KAFKA_TOPIC_MARKET_SWAPS=market-swaps
KAFKA_TOPIC_SECURITY_ALERTS=security-alerts

# --- Zookeeper (coordination — usually internal only) ------------------------
ZOOKEEPER_PORT=2181

# --- Kafka UI (web console — MEDIUM sensitivity) -----------------------------
# Host port 8089 avoids conflict with Analytics API + Socket.IO (default 8080)
KAFKA_UI_PORT=8089

# --- pgAdmin (DB web console — HIGH sensitivity) -----------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@aegisflow.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password

# --- Application services (docker-compose.apps.yml overlay) ----------------
ANALYTICS_PORT=8080
WEB_PORT=5173
LOG_LEVEL=info

# Required for analytics container (min 32 characters)
JWT_SECRET=change_me_jwt_secret_min_32_chars

# Docker-internal URLs (host apps use localhost above)
DATABASE_URL_DOCKER=postgresql://aegis_admin:change_me_strong_password@postgres:5432/aegisflow_db
REDIS_URL_DOCKER=redis://redis:6379
# If REDIS_PASSWORD is set: REDIS_URL_DOCKER=redis://:your_password@redis:6379

KAFKA_GROUP_ID=analytics-core-group
SIWE_DOMAIN=localhost
SIWE_URI=http://localhost:8080

# Web build-time (browser-facing API / WebSocket)
VITE_API_BASE_URL=http://localhost:8080
VITE_WS_URL=
VITE_WALLETCONNECT_PROJECT_ID=

# Optional indexer profile (--profile indexer)
RPC_WS_URL=wss://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY
UNISWAP_FACTORY_ADDRESS=0x5C69bEe701ef814a2B6a3EDD4B1652CB9cc5aA6f
