# =============================================================================
# AegisFlow — Infrastructure environment variables (TEMPLATE)
# =============================================================================
# Copy to .env and replace placeholder values before running:
#   copy .env.example .env
#   docker compose up -d
#
# NEVER commit .env to version control.
# =============================================================================

# --- PostgreSQL (credentials — HIGH sensitivity) ---------------------------
POSTGRES_USER=aegis_admin
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=aegisflow_db
POSTGRES_PORT=5432

# Connection URL for application services (Indexer, Analytics Core)
DATABASE_URL=postgresql://aegis_admin:change_me_strong_password@localhost:5432/aegisflow_db

# --- Redis (cache — MEDIUM sensitivity if password enabled) ----------------
REDIS_PORT=6379
# Leave empty for local dev without auth; set a strong password in production
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# --- Kafka (event bus — MEDIUM sensitivity in production) ------------------
KAFKA_EXTERNAL_HOST=localhost
KAFKA_EXTERNAL_PORT=9092
KAFKA_INTERNAL_BOOTSTRAP=kafka:29092
KAFKA_BROKER_PORT=9092

# MVP topic names (created by kafka-init on startup)
KAFKA_TOPIC_MARKET_SWAPS=market-swaps
KAFKA_TOPIC_SECURITY_ALERTS=security-alerts

# --- Zookeeper (coordination — usually internal only) ------------------------
ZOOKEEPER_PORT=2181

# --- Kafka UI (web console — MEDIUM sensitivity) -----------------------------
KAFKA_UI_PORT=8080

# --- pgAdmin (DB web console — HIGH sensitivity) -----------------------------
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@aegisflow.local
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin_password
